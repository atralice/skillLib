{
  "name": "skilllib",
  "version": "1.4.0",
  "description": "Manage your agent skills like dependencies. One library for all your skills; each repo gets only the ones it needs, and every agent can see them. Works with Claude Code, Cursor, Codex and Zed.",
  "keywords": [
    "agent-skills",
    "skills",
    "skill-md",
    "claude-code",
    "claude",
    "cursor",
    "codex",
    "zed",
    "ai-agents",
    "skills-manager",
    "cli",
    "tui"
  ],
  "homepage": "https://github.com/atralice/skillLib#readme",
  "bugs": {
    "url": "https://github.com/atralice/skillLib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atralice/skillLib.git"
  },
  "license": "MIT",
  "author": "Toni Tralice",
  "type": "module",
  "bin": {
    "skilllib": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "dev": "tsx src/index.ts",
    "design": "tsx src/tui/design.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
