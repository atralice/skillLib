{
  "name": "@atralice/skilllib",
  "version": "0.3.0",
  "description": "Keep a library of Claude Code skills and choose which ones each project gets",
  "keywords": ["claude", "claude-code", "cli", "skills"],
  "license": "MIT",
  "author": "atralice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atralice/skillLib.git"
  },
  "type": "module",
  "bin": {
    "skilllib": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
