{
  "name": "@atralice/skilllib",
  "version": "0.1.0",
  "description": "CLI for the skillLib skill registry",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "package-manager",
    "registry",
    "skilllib",
    "skills"
  ],
  "homepage": "https://github.com/atralice/skillLib#readme",
  "bugs": {
    "url": "https://github.com/atralice/skillLib/issues"
  },
  "license": "MIT",
  "author": "atralice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atralice/skillLib.git",
    "directory": "packages/cli"
  },
  "bin": {
    "skilllib": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "semver": "^7.7.2",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
